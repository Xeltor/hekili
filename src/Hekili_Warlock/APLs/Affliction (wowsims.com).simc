# Affliction (wowsims.com): the wowsims/forever default APL for Affliction (ui/specs/warlock/dps/builds/aff_wrack.build.json), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at ab0f00e4fc83.
# Leveling, outdoor pulls, and dungeons use learned spells, pet care, and health-aware mana recovery.
# Ordinary pulls favor a small number of DoTs, while durable targets get sustained debuff and spell priorities.
# Raid damage follows the pinned WoWSims priority.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/warlock_affliction.lua: edit that recipe, not this file.
# Setting assigned_curse (choice of curseOptions: elements, nocurse, recklessness, weakness), default elements in game and in the harness.
# Deviation: precombat #1: the pre-pull time uses the kit's base cast time; wowsims uses the hasted cast.
# Cycle: single_multi_target_curse_logic #2 changeTarget -> #1 curse_of_the_elements, curse_of_recklessness, curse_of_weakness: cycle_targets=1 (shown with Recommend Target Swaps on)
# Cycle: multi_target_dot_logic #5 changeTarget -> #4 corruption: cycle_targets=1 (shown with Recommend Target Swaps on)
# Deviation: multi_target_dot_logic #5: the swap's other terms (dotBaseDuration, dotIsActive, numberTargets, remainingTime, variableRef, warlockAssignedCurseIsActive, warlockIsAssignedCurse) are not carried; the list's order gives them
# Omitted: precombat #2: petAttack
# Omitted: multi_target_dot_logic #3: changeTarget NextTarget: no on-all-targets read of a cast before it in this list
# Omitted: multi_target_dot_logic #6: changeTarget Target: no main target in Hekili
# Omitted: cooldowns #1: item 249469
# Omitted: cooldowns #2: item 250937

actions.precombat=healthstone,use_off_gcd=1,display_below=30,if=combat>0&warlock_pve_context
actions.precombat+=/healing_potion,use_off_gcd=1,display_below=40,if=combat>0&warlock_pve_context
actions.precombat+=/health_funnel,if=warlock_funnel_safe
actions.precombat+=/life_tap,if=warlock_can_prepare&warlock_life_tap_safe&mana.hi<0.65*mana.max
actions.precombat+=/summon_voidwalker,if=warlock_can_summon&warlock_outdoors&solo
actions.precombat+=/summon_imp,if=warlock_can_summon
actions.precombat+=/demon_armor,if=warlock_can_prepare&buff.demon_armor.down
actions.precombat+=/demon_skin,if=warlock_can_prepare&!action.demon_armor.known&buff.demon_skin.down&(!action.demon_armor.known|buff.demon_armor.down)
actions.precombat+=/death_coil,if=combat>0&warlock_pve_target&warlock_engaged&toggle.defensives&warlock_health_low
actions.precombat+=/drain_life,if=combat>0&warlock_pve_target&warlock_engaged&toggle.defensives&warlock_health_low&warlock_drain_life_in_range
actions.precombat+=/shadow_bolt,if=warlock_contextual&warlock_engaged&buff.shadow_trance.up
actions.precombat+=/curse_of_the_elements,if=warlock_contextual&warlock_engaged&!warlock_short_pull&settings.assigned_curse='elements'&debuff.curse_of_the_elements.down
actions.precombat+=/curse_of_recklessness,if=warlock_contextual&warlock_engaged&!warlock_short_pull&settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.down
actions.precombat+=/curse_of_weakness,if=warlock_contextual&warlock_engaged&!warlock_short_pull&settings.assigned_curse='weakness'&debuff.curse_of_weakness.down
actions.precombat+=/rain_of_fire,if=warlock_contextual&warlock_engaged&combat>0&warlock_aoe
actions.precombat+=/corruption,if=warlock_contextual&warlock_engaged&!warlock_short_pull&debuff.corruption.remains<=action.corruption.cast&!action.corruption.executing
actions.precombat+=/bane_of_agony,if=warlock_contextual&warlock_engaged&!warlock_short_pull&debuff.bane_of_agony.down&(!action.bane_of_doom.known|debuff.bane_of_doom.down)
actions.precombat+=/siphon_life,if=warlock_contextual&warlock_engaged&!warlock_short_pull&debuff.siphon_life.down
actions.precombat+=/immolate,if=warlock_contextual&warlock_engaged&!warlock_short_pull&debuff.immolate.remains<=action.immolate.cast&!action.immolate.executing
actions.precombat+=/immolate,if=warlock_contextual&warlock_engaged&warlock_short_pull&(level<10|!action.corruption.known)&!warlock_target_low&debuff.immolate.down&!action.immolate.executing
actions.precombat+=/corruption,if=warlock_contextual&warlock_engaged&warlock_short_pull&debuff.corruption.down&!action.corruption.executing&!(level<10&warlock_target_low)
actions.precombat+=/drain_soul,if=warlock_contextual&warlock_engaged&warlock_short_pull&combat>0&warlock_outdoors&solo&warlock_shard_count<2&!warlock_wanding&!warlock_health_low&(warlock_shard_window|warlock_shard_target&warlock_pet_tanking&(action.corruption.known&debuff.corruption.up|action.immolate.known&debuff.immolate.up))
