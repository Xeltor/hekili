actions.precombat+=/cannibalize,if=warlock_cannibalize_corpse&buff.cannibalize.down&mana.hi<0.65*mana.max
actions.precombat+=/cannibalize,display_below=65,if=warlock_cannibalize_corpse&buff.cannibalize.down
