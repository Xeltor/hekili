actions+=/searing_pain,focus=2,if=((!debuff.demonic_brand.up|debuff.demonic_brand.remains<2.5)&!action.searing_pain.executing&(!(active_enemies>=3)|target.outside5))&!warlock_contextual
actions+=/call_action_list,name=single_target_dot_logic,if=active_enemies=1&!warlock_contextual
actions+=/call_action_list,name=multi_target_dot_logic,if=active_enemies>1&!warlock_contextual
