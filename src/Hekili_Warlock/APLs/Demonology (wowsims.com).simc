actions+=/life_tap,if=!warlock_contextual&(!action.shadow_bolt.known|mana.lo<action.shadow_bolt.cost)
actions.single_multi_target_curse_logic=curse_of_the_elements,cycle_targets=1,focus=2,if=settings.assigned_curse='elements'&(!((settings.assigned_curse='elements'&debuff.curse_of_the_elements.up)|(action.curse_of_recklessness.known&settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.up)|(action.curse_of_weakness.known&settings.assigned_curse='weakness'&debuff.curse_of_weakness.up))&!(settings.assigned_curse='nocurse'))
actions.single_multi_target_curse_logic+=/curse_of_recklessness,cycle_targets=1,focus=2,if=settings.assigned_curse='recklessness'&(!((action.curse_of_the_elements.known&settings.assigned_curse='elements'&debuff.curse_of_the_elements.up)|(settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.up)|(action.curse_of_weakness.known&settings.assigned_curse='weakness'&debuff.curse_of_weakness.up))&!(settings.assigned_curse='nocurse'))
actions.single_multi_target_curse_logic+=/curse_of_weakness,cycle_targets=1,focus=2,if=settings.assigned_curse='weakness'&(!((action.curse_of_the_elements.known&settings.assigned_curse='elements'&debuff.curse_of_the_elements.up)|(action.curse_of_recklessness.known&settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.up)|(settings.assigned_curse='weakness'&debuff.curse_of_weakness.up))&!(settings.assigned_curse='nocurse'))
actions.multi_target_dot_logic=bane_of_agony,focus=2,if=((!action.bane_of_doom.known|!debuff.bane_of_doom.up)&!debuff.bane_of_agony.up&active_enemies<5)
actions.multi_target_dot_logic+=/immolate,cycle_targets=1,focus=2,if=(!debuff.immolate.up&fight_remains>debuff.immolate.duration&(!(active_enemies>=3)|target.outside5))&!warlock_contextual
actions.multi_target_dot_logic+=/corruption,cycle_targets=1,focus=2,if=(!debuff.corruption.up&fight_remains>debuff.corruption.duration&(!(active_enemies>=3)|target.outside5))
actions.single_target_dot_logic=bane_of_agony,focus=2,if=((!action.bane_of_doom.known|!debuff.bane_of_doom.up)&!debuff.bane_of_agony.up&fight_remains>debuff.bane_of_agony.duration)
actions.single_target_dot_logic+=/immolate,focus=2,if=(!debuff.immolate.up&fight_remains>debuff.immolate.duration)&!warlock_contextual
actions.single_target_dot_logic+=/corruption,focus=2,if=(!debuff.corruption.up&fight_remains>debuff.corruption.duration)
actions.cooldowns=eureka,use_off_gcd=1,if=(!action.bane_of_doom.known|((action.bane_of_doom.known&((!action.bane_of_doom.known|debuff.bane_of_doom.remains<8)&(!action.bane_of_doom.known|debuff.bane_of_doom.up)))|(action.bane_of_doom.known&!debuff.bane_of_doom.up)))
actions.cooldowns+=/blood_fury,use_off_gcd=1,if=(!action.bane_of_doom.known|((action.bane_of_doom.known&((!action.bane_of_doom.known|debuff.bane_of_doom.remains<15)&(!action.bane_of_doom.known|debuff.bane_of_doom.up)))|(action.bane_of_doom.known&!debuff.bane_of_doom.up)))
actions.cooldowns+=/berserking,use_off_gcd=1,if=(!action.bane_of_doom.known|((action.bane_of_doom.known&((!action.bane_of_doom.known|debuff.bane_of_doom.remains<15)&(!action.bane_of_doom.known|debuff.bane_of_doom.up)))|(action.bane_of_doom.known&!debuff.bane_of_doom.up)))&!warlock_contextual
actions.cooldowns+=/searing_pain,if=((!action.bane_of_doom.known|debuff.bane_of_doom.remains<15)&(!action.bane_of_doom.known|debuff.bane_of_doom.up)&active_enemies=1)&!warlock_contextual
actions.cooldowns+=/life_tap,if=((!action.bane_of_doom.known|((action.bane_of_doom.known&debuff.bane_of_doom.remains<22)|(action.bane_of_doom.known&!debuff.bane_of_doom.up)))&((mana.lo<2600&mana.pct_lo<42)&fight_remains>60))&!warlock_contextual
