# SM Ruin (wowsims.com): the wowsims/forever default APL for SM Ruin (ui/specs/warlock/dps/builds/sm_ruin.build.json), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at ab0f00e4fc83.
# Leveling, outdoor pulls, and dungeons use learned spells, pet care, and health-aware mana recovery.
# Ordinary pulls favor a small number of DoTs, while durable targets get sustained debuff and spell priorities.
# Raid damage follows the pinned WoWSims priority.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/warlock_sm_ruin.lua: edit that recipe, not this file.
# Setting assigned_curse (choice of curseOptions: elements, nocurse, recklessness, weakness), default elements in game and in the harness.
# Omitted: default #3: hidden
# Omitted: default #6: spellExpectedDpet
# Omitted: default #7: spellExpectedDpet
# Omitted: default #8: spellExpectedDpet
# Omitted: default #9: spellExpectedDpet
# Omitted: default #10: spellExpectedDpet

actions=healthstone,use_off_gcd=1,display_below=30,if=combat>0&warlock_pve_context
actions+=/healing_potion,use_off_gcd=1,display_below=40,if=combat>0&warlock_pve_context
actions+=/health_funnel,if=warlock_funnel_safe
actions+=/life_tap,if=warlock_can_prepare&warlock_life_tap_safe&mana.hi<0.65*mana.max
actions+=/summon_voidwalker,if=warlock_can_summon&warlock_outdoors&solo
actions+=/summon_imp,if=warlock_can_summon
actions+=/demon_armor,if=warlock_can_prepare&buff.demon_armor.down
actions+=/demon_skin,if=warlock_can_prepare&!action.demon_armor.known&buff.demon_skin.down&(!action.demon_armor.known|buff.demon_armor.down)
actions+=/death_coil,if=combat>0&warlock_pve_target&warlock_engaged&toggle.defensives&warlock_health_low
actions+=/drain_life,if=combat>0&warlock_pve_target&warlock_engaged&toggle.defensives&warlock_health_low&warlock_drain_life_in_range
actions+=/shadow_bolt,focus=1,if=warlock_contextual&warlock_engaged&buff.shadow_trance.up
actions+=/curse_of_the_elements,focus=2,if=warlock_contextual&warlock_engaged&!warlock_short_pull&settings.assigned_curse='elements'&debuff.curse_of_the_elements.down
actions+=/curse_of_recklessness,focus=2,if=warlock_contextual&warlock_engaged&!warlock_short_pull&settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.down
actions+=/curse_of_weakness,focus=2,if=warlock_contextual&warlock_engaged&!warlock_short_pull&settings.assigned_curse='weakness'&debuff.curse_of_weakness.down
actions+=/rain_of_fire,if=warlock_contextual&warlock_engaged&combat>0&warlock_aoe
actions+=/corruption,focus=2,if=warlock_contextual&warlock_engaged&!warlock_short_pull&debuff.corruption.remains<=action.corruption.cast&!action.corruption.executing
actions+=/bane_of_agony,focus=2,if=warlock_contextual&warlock_engaged&!warlock_short_pull&debuff.bane_of_agony.down&(!action.bane_of_doom.known|debuff.bane_of_doom.down)
actions+=/siphon_life,focus=2,if=warlock_contextual&warlock_engaged&!warlock_short_pull&debuff.siphon_life.down
actions+=/immolate,focus=2,if=warlock_contextual&warlock_engaged&!warlock_short_pull&debuff.immolate.remains<=action.immolate.cast&!action.immolate.executing
actions+=/immolate,focus=2,if=warlock_contextual&warlock_engaged&warlock_short_pull&(level<10|!action.corruption.known)&!warlock_target_low&debuff.immolate.down&!action.immolate.executing
actions+=/corruption,focus=2,if=warlock_contextual&warlock_engaged&warlock_short_pull&debuff.corruption.down&!action.corruption.executing&!(level<10&warlock_target_low)
actions+=/drain_soul,if=warlock_contextual&warlock_engaged&warlock_short_pull&combat>0&warlock_outdoors&solo&warlock_shard_count<2&!warlock_wanding&!warlock_health_low&(warlock_shard_window|warlock_shard_target&warlock_pet_tanking&(action.corruption.known&debuff.corruption.up|action.immolate.known&debuff.immolate.up))
actions+=/shoot,use_off_gcd=1,if=warlock_contextual&warlock_engaged&warlock_short_pull
actions+=/life_tap,if=warlock_contextual&warlock_engaged&!(warlock_wanding&warlock_short_pull)&combat>0&warlock_life_tap_safe&mana.hi<0.30*mana.max
actions+=/shadow_bolt,if=warlock_contextual&warlock_engaged&!(warlock_wanding&warlock_short_pull)
actions+=/shoot,use_off_gcd=1,if=warlock_contextual&warlock_engaged
actions+=/auto_attack,use_off_gcd=1,if=warlock_contextual&warlock_engaged
actions+=/eureka,use_off_gcd=1,if=!warlock_contextual
actions+=/blood_fury,use_off_gcd=1,if=!warlock_contextual
actions+=/berserking,use_off_gcd=1,if=!warlock_contextual
actions+=/use_items,use_off_gcd=1,if=!warlock_contextual
actions+=/demonic_rune,use_off_gcd=1,if=!warlock_contextual
actions+=/major_mana_potion,use_off_gcd=1,if=!warlock_contextual
actions+=/curse_of_the_elements,focus=2,if=(settings.assigned_curse='elements'&(!((settings.assigned_curse='elements'&debuff.curse_of_the_elements.up)|(action.curse_of_recklessness.known&settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.up)|(action.curse_of_weakness.known&settings.assigned_curse='weakness'&debuff.curse_of_weakness.up))))&!warlock_contextual
actions+=/curse_of_recklessness,focus=2,if=(settings.assigned_curse='recklessness'&(!((action.curse_of_the_elements.known&settings.assigned_curse='elements'&debuff.curse_of_the_elements.up)|(settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.up)|(action.curse_of_weakness.known&settings.assigned_curse='weakness'&debuff.curse_of_weakness.up))))&!warlock_contextual
actions+=/curse_of_weakness,focus=2,if=(settings.assigned_curse='weakness'&(!((action.curse_of_the_elements.known&settings.assigned_curse='elements'&debuff.curse_of_the_elements.up)|(action.curse_of_recklessness.known&settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.up)|(settings.assigned_curse='weakness'&debuff.curse_of_weakness.up))))&!warlock_contextual
actions+=/bane_of_doom,focus=2,if=fight_remains>=60&!warlock_contextual
actions+=/shadow_bolt,focus=1,if=buff.shadow_trance.up&!warlock_contextual
actions+=/corruption,focus=2,if=(debuff.corruption.remains<=action.corruption.cast)&!warlock_contextual
actions+=/siphon_life,focus=2,if=(debuff.siphon_life.remains<=action.siphon_life.cast)&!warlock_contextual
actions+=/immolate,focus=2,if=(debuff.immolate.remains<=action.immolate.cast)&!warlock_contextual
actions+=/life_tap,if=(mana.pct_lo<30&fight_remains>60)&!warlock_contextual
actions+=/shadow_bolt,if=!warlock_contextual
actions+=/life_tap,if=!warlock_contextual&(!action.shadow_bolt.known|mana.lo<action.shadow_bolt.cost)
