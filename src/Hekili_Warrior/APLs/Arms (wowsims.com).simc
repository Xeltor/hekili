# Arms (wowsims.com): the wowsims/forever default APL for Arms (ui/specs/warrior/dps/apls/arms.apl.json), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at e2842f0a784d.
# Cooldowns toggle hides: Death Wish, Recklessness (also behind its pack setting, off by default), Sweeping Strikes and the racials (Blood Fury, Berserking, Eureka, Elune's Light).
# The endgame priority adapts as you learn abilities. Open-world pulls use earlier Rend and spend less rage on armor stacks.
# While leveling or fighting outdoors, Bloodrage favors low rage. Readable health must be at least 65%; hidden health in combat leaves it eligible.
# Rend skips known bleed-immune targets and backs off briefly after an immune result in PvE.
# Hamstring slows non-boss PvE humanoids in melee range when they enter Execute range.
# PvE utility follows your Interrupts and Defensives toggles. Retaliation also follows Cooldowns.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/warrior_arms.lua: edit that recipe, not this file.
# Setting wowsims_recklessness (wowsims ON/OFF group), default false.
# Setting wowsims_stance_dance (wowsims ON/OFF group), default false.
# Setting maintain_thunder_clap (maintenance debuff: thunder_clap), default off in game, on in the harness.
# Omitted: default #1: hidden
# Omitted: default #2: hidden
# Omitted: default #7: hidden
# Omitted: default #8: other OtherActionOffensivePotion
# Omitted: default #9: other OtherActionResourcePotion
# Omitted: default #10: other OtherActionOffensivePotion
# Omitted: default #29: never
# Omitted: default #35: hidden
# Omitted: default #36: hidden
# Omitted: default #37: hidden
# Omitted: engineering #1: item 10646
# Omitted: engineering #2: item 11566
# Omitted: engineering #3: item 18588
# Omitted: cd_trinkets #1: castAllStatBuffCooldowns: none in the log
# Omitted: cd_trinkets #2: castAllStatBuffCooldowns: none in the log
# Omitted: cd_trinkets #3: item 21670
# Omitted: cd_trinkets #4: item 23041
# Omitted: cd_trinkets #5: item 22954
# Omitted: cd_trinkets #6: spell 29602
# Omitted: cd_trinkets #7: item 21891
# Omitted: cd_trinkets #8: item 274759
# Omitted: default: empty group engineering
# Omitted: default: empty group cd_trinkets

actions.precombat=berserker_rage,if=talent.improved_berserker_rage.enabled
actions.precombat+=/call_action_list,name=pre_pull_stance
actions.precombat+=/bloodrage,use_off_gcd=1,if=arms_bloodrage_safe
actions.precombat+=/battle_shout,if=!buff.battle_shout.up
actions.precombat+=/call_action_list,name=pre_pull_move
actions=shield_bash,if=arms_pve_target&combat>0&target.within5&!target.outside5&debuff.casting.up&debuff.casting.v2=0
actions+=/pummel,if=arms_pve_target&combat>0&target.within5&!target.outside5&debuff.casting.up&debuff.casting.v2=0
actions+=/healthstone,use_off_gcd=1,if=arms_pve_target&combat>0&health.pct<=30
actions+=/shield_wall,if=arms_pve_target&combat>0&health.pct<=25&(!action.last_stand.known|!buff.last_stand.up)
actions+=/last_stand,use_off_gcd=1,if=arms_pve_target&combat>0&health.pct<=35&(!action.shield_wall.known|!buff.shield_wall.up)
actions+=/victory_rush,focus=1,if=arms_pve_target&combat>0&health.pct<=75
actions+=/retaliation,if=arms_open_world&combat>0&target.within5&!target.outside5&toggle.defensives&health.pct<=45&active_enemies>=2&(!action.last_stand.known|!buff.last_stand.up)&(!action.shield_wall.known|!buff.shield_wall.up)
actions+=/demoralizing_shout,if=arms_open_world&combat>0&target.within5&!target.outside5&toggle.defensives&health.pct<=75&active_enemies>=2&debuff.demoralizing_shout.down
actions+=/hamstring,if=arms_pve_target&combat>0&target.within5&!target.outside5&!boss&!target.is_boss&target.creature_type='humanoid'&execute_phase&debuff.hamstring.down
actions+=/call_action_list,name=sunder_armor,if=active_enemies=1&!(arms_open_world&arms_short_pull)
actions+=/call_action_list,name=cd_racials
actions+=/death_wish,if=(fight_remains<=buff.death_wish.duration|fight_remains>(cooldown.death_wish.duration+(buff.death_wish.duration/2)))
actions+=/recklessness,if=((settings.wowsims_recklessness&settings.wowsims_stance_dance)&(fight_remains<=buff.recklessness.duration|fight_remains>(cooldown.recklessness.duration+(buff.recklessness.duration/2))))
actions+=/sweeping_strikes,use_off_gcd=1,if=active_enemies>1
actions+=/battle_stance,use_off_gcd=1,if=(!settings.wowsims_stance_dance&!buff.battle_stance.up)&(!arms_skip_rend|!settings.wowsims_stance_dance|buff.overpower_ready.up)
actions+=/victory_rush,focus=1
actions+=/mortal_strike,if=settings.wowsims_stance_dance
actions+=/battle_stance,use_off_gcd=1,if=((settings.wowsims_stance_dance&!execute_phase&(!action.berserker_stance.known|buff.berserker_stance.up)&(!action.battle_stance.known|cooldown.battle_stance.remains<=0))&buff.overpower_ready.up&buff.overpower_ready.remains>gcd.remains&rage.lo>=5&(!action.overpower.known|cooldown.overpower.remains<=0))&(!arms_skip_rend|!settings.wowsims_stance_dance|buff.overpower_ready.up)
actions+=/overpower,focus=1,if=((action.battle_stance.known&prev.1.battle_stance)|(!action.battle_stance.known&((settings.wowsims_stance_dance&!execute_phase&(!action.berserker_stance.known|buff.berserker_stance.up)&(!action.battle_stance.known|cooldown.battle_stance.remains<=0))&buff.overpower_ready.up&buff.overpower_ready.remains>gcd.remains&rage.lo>=5&(!action.overpower.known|cooldown.overpower.remains<=0))))&(buff.overpower_ready.up&buff.overpower_ready.remains>gcd.remains&rage.lo>=5&(!action.overpower.known|cooldown.overpower.remains<=0))
actions+=/overpower,focus=1,if=(!action.battle_stance.known|buff.battle_stance.up)
actions+=/berserker_stance,use_off_gcd=1,if=(!settings.wowsims_stance_dance&active_enemies>=3&rage.lo>=25&gcd.remains<=0&!buff.berserker_stance.up&(!action.whirlwind.known|cooldown.whirlwind.ready))
actions+=/whirlwind,if=(!settings.wowsims_stance_dance&active_enemies>=3)
actions+=/mortal_strike,if=!settings.wowsims_stance_dance
actions+=/bloodrage,use_off_gcd=1,if=arms_pve_target&combat>0&(level<60|arms_open_world)&rage.lo<=15&arms_bloodrage_safe
actions+=/rend,focus=2,if=arms_open_world&combat>0&!arms_skip_rend&!execute_phase&debuff.rend.down
actions+=/slam,if=(!execute_phase&(!action.mortal_strike.known|action.slam.cast<action.mortal_strike.gcd))
actions+=/battle_stance,use_off_gcd=1,if=((settings.wowsims_stance_dance&!execute_phase&(!action.berserker_stance.known|buff.berserker_stance.up)&(!action.battle_stance.known|cooldown.battle_stance.remains<=0))&(!action.rend.known|debuff.rend.remains<=action.rend.gcd)&rage.lo>=10)&(!arms_skip_rend|!settings.wowsims_stance_dance|buff.overpower_ready.up)
actions+=/rend,focus=2,if=((action.battle_stance.known&prev.1.battle_stance)|(!action.battle_stance.known&((settings.wowsims_stance_dance&!execute_phase&(!action.berserker_stance.known|buff.berserker_stance.up)&(!action.battle_stance.known|cooldown.battle_stance.remains<=0))&(!action.rend.known|debuff.rend.remains<=action.rend.gcd)&rage.lo>=10)))&((!action.rend.known|debuff.rend.remains<=action.rend.gcd)&rage.lo>=10)&!arms_skip_rend
actions+=/rend,focus=2,if=(!execute_phase&(!action.battle_stance.known|buff.battle_stance.up)&debuff.rend.remains<=action.rend.gcd)&!arms_skip_rend
actions+=/slam,if=(!execute_phase&(!action.mortal_strike.known|action.slam.cast>=action.mortal_strike.gcd)&mainhand_remains>=mainhand_speed-(0+0.3))
actions+=/spearing_strike,if=(!execute_phase&(!action.battle_stance.known|buff.battle_stance.up))
actions+=/berserker_stance,use_off_gcd=1,if=(settings.wowsims_stance_dance&(!action.battle_stance.known|buff.battle_stance.up)&!buff.overpower_ready.up&(execute_phase|(action.rend.known&debuff.rend.remains>action.rend.gcd)))
actions+=/whirlwind,if=settings.wowsims_stance_dance
actions+=/execute,if=execute_phase
actions+=/cleave,use_off_gcd=1,focus=2,if=(active_enemies>1&rage.lo>=40)
actions+=/heroic_strike,use_off_gcd=1,focus=2,if=arms_open_world&combat>0&arms_short_pull&action.mortal_strike.known&!execute_phase&active_enemies=1&rage.lo>=65
actions+=/heroic_strike,use_off_gcd=1,focus=2,if=(!execute_phase&rage.lo>=90&!talent.improved_slam.enabled)
actions+=/bloodrage,use_off_gcd=1,if=rage.lo<90&arms_bloodrage_safe
actions+=/battle_shout,if=(((!action.mortal_strike.known|cooldown.mortal_strike.remains>=action.mortal_strike.gcd)&(!settings.wowsims_stance_dance|(action.whirlwind.known&cooldown.whirlwind.remains>=action.whirlwind.gcd)))&buff.battle_shout.remains<=10)
actions+=/heroic_strike,use_off_gcd=1,focus=2,if=level<60&combat>0&!action.rend.known
actions+=/sunder_armor,if=arms_open_world&combat>0&arms_short_pull&arms_skip_rend&!action.mortal_strike.known&!execute_phase&debuff.sunder_armor.stack=0
actions+=/heroic_strike,use_off_gcd=1,focus=2,if=!action.mortal_strike.known&(rage.lo>=40|(!arms_open_world|arms_skip_rend)&rage.lo>=30)
actions+=/thunder_clap,if=settings.maintain_thunder_clap&!action.mortal_strike.known&!debuff.thunder_clap.up
actions+=/sunder_armor,if=!action.mortal_strike.known&debuff.sunder_armor.stack<5&!(arms_open_world&arms_short_pull)
actions.pre_pull_stance=battle_stance,use_off_gcd=1,if=!buff.battle_stance.up&(!settings.wowsims_stance_dance&(!arms_skip_rend|!settings.wowsims_stance_dance|buff.overpower_ready.up))
actions.pre_pull_move=charge,use_off_gcd=1,if=(!action.battle_stance.known|buff.battle_stance.up)
actions.pre_pull_move+=/intercept,use_off_gcd=1,if=(!action.berserker_stance.known|buff.berserker_stance.up)
actions.cd_racials=blood_fury,use_off_gcd=1,if=(fight_remains<=buff.blood_fury.duration|fight_remains>(cooldown.blood_fury.duration+(buff.blood_fury.duration/2)))
actions.cd_racials+=/berserking,use_off_gcd=1,if=(fight_remains<=buff.berserking.duration|fight_remains>(cooldown.berserking.duration+(buff.berserking.duration/2)))
actions.cd_racials+=/eureka,use_off_gcd=1,if=(fight_remains<=buff.eureka.duration|fight_remains>(cooldown.eureka.duration+(buff.eureka.duration/2)))
actions.cd_racials+=/elunes_light,use_off_gcd=1,if=(!(settings.wowsims_recklessness&settings.wowsims_stance_dance)&(fight_remains<=buff.elunes_light.duration|fight_remains>(cooldown.elunes_light.duration+(buff.elunes_light.duration/2))))
actions.cd_racials+=/elunes_light,use_off_gcd=1,if=((settings.wowsims_recklessness&settings.wowsims_stance_dance)&(!action.recklessness.known|!buff.recklessness.up)&fight_remains>15&(fight_remains>195|fight_remains<=30))
actions.sunder_armor=sunder_armor,if=debuff.sunder_armor.stack<5&!(arms_open_world&arms_short_pull)
